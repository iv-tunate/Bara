# ========== Build & Publish ==========
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
ARG BUILD_CONFIGURATION=Release
WORKDIR /src

# Copy solution and all project files for better caching
COPY Backend.sln ./
COPY Bara.API/Bara.API.csproj Bara.API/
COPY BaraTests/BaraTests.csproj BaraTests/

RUN dotnet restore Backend.sln

COPY . .

# Build and publish
WORKDIR /src/Bara.API
RUN dotnet publish -c $BUILD_CONFIGURATION -o /app/publish \
    /p:UseAppHost=false

# ========== Runtime ==========
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
WORKDIR /app

# Install curl for healthchecks, then clean up in same layer (smaller image)
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl && \
    rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -r appgroup && useradd -r -g appgroup appuser

# Copy published app
COPY --chown=appuser:appgroup --from=build /app/publish .

# Create logs directory with correct permissions
RUN mkdir -p /app/Logs && chown -R appuser:appgroup /app/Logs

# Switch to non-root user
USER appuser

# Environment configuration
ENV ASPNETCORE_ENVIRONMENT=Production \
    ASPNETCORE_URLS=http://+:8080 \
    DOTNET_RUNNING_IN_CONTAINER=true

EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -f http://localhost:8080/health/basic_health_check || exit 1

ENTRYPOINT ["dotnet", "Bara.API.dll"]